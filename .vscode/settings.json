{
  // Python из виртуального окружения сборки. Создаётся командой .\build.ps1.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv-build/Scripts/python.exe",
  "python.analysis.extraPaths": ["src"],

  // Тесты видны на панели Testing.
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-s", "tests", "-p", "test_*.py"],

  // Единый вид файлов.
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.rulers": [120],
  "[python]": { "editor.tabSize": 4 },

  // Служебные папки не мешают при поиске и в дереве файлов.
  "files.exclude": {
    "**/__pycache__": true,
    "build": true,
    ".venv-build": true
  },
  "search.exclude": {
    "dist": true,
    "GiDo/*.gif": true,
    "src/assets_data.py": true
  }
}
